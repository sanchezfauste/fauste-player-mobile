<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Fluently (Task 5, i18n) declares minSdk 28 in its AAR manifests —
         template noise, not a real API floor: a bytecode scan of both
         artifacts (fluently-core/fluently-frontend, 65 + parser classes)
         shows ZERO android.* references (pure Kotlin/ANTLR, packaged as
         AARs), so the app's pinned minSdk 26 floor (the project contract)
         stays. overrideLibrary records exactly that verification; if a
         future Fluently version gains a real Android dependency, this
         line will lie — re-scan on any version bump. -->
    <uses-sdk tools:overrideLibrary="dev.karmakrafts.fluently.fluently" />

    <!-- The audio-read permission pair the platform contract names
         (READ_MEDIA_AUDIO on API 33+, READ_EXTERNAL_STORAGE below):
         declared here, requested at runtime on the first Import tap. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- INTERNET (the fix-wave smoke's real find): Android grants AF_INET
         sockets only to apps holding this permission (the kernel's inet
         group), even for 127.0.0.1 — without it the engine's loopback
         remote binds nowhere (EACCES, silently retried) and the app's own
         RemoteApi client can never reach it, killing the whole remote
         feature on-device while every host lane stays green (the JVM
         enforces nothing). Declared, not runtime-requested: INTERNET is
         a normal install-time permission. The NSC below still pins the
         traffic itself to loopback cleartext-only. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The foreground playback service (Task 6, Ruling 5): FOREGROUND_SERVICE
         is the API 26 base requirement; FOREGROUND_SERVICE_MEDIA_PLAYBACK is
         the API 34 type requirement for a mediaPlayback-typed service.
         POST_NOTIFICATIONS (API 33+) is requested at runtime in MainActivity —
         with the honest degradation documented there: a denial hides the
         drawer notification only (verified on the API 34 emulator); playback
         and this service run on unaffected. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".FausteApplication"
        android:label="Fauste Player"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Fauste">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The playback foreground service (Task 6): media3's
             MediaSessionService contract — the action intent filter is
             what MediaControllers and media-button routing bind through;
             the mediaPlayback type matches what the library promotes the
             service with on first Play (Ruling 5). exported=true is
             required for external MediaController connections
             (Bluetooth, System UI). -->
        <service
            android:name=".service.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
